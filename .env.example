# Environment Variables for ForecastIQ

# Application
APP_NAME=ForecastIQ
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=super-secret-key-change-this-in-production-min-32-chars-long!
ALLOWED_HOSTS=localhost,127.0.0.1

# Security & Auth
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=forecastiq
POSTGRES_PASSWORD=forecastiq_password
POSTGRES_DB=forecastiq_db
DATABASE_URL=postgresql+asyncpg://forecastiq:forecastiq_password@localhost:5432/forecastiq_db

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# CORS Settings
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Storage (AWS S3 Compatible)
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=forecastiq-datasets
AWS_REGION=us-east-1
